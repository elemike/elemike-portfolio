# ==========================================
# Dependencies
# ==========================================
/node_modules
/.pnpm-store
/.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ==========================================
# Next.js Build Output
# ==========================================
/.next/
/out/
/build
/dist

# ==========================================
# Testing & Jest
# ==========================================
# Reportes de cobertura de código
/coverage
/coverage-final.json

# Archivos temporales de test runner y caché de Jest
/.jest/
*.lcov

# ==========================================
# Logs & Debugging
# ==========================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# ==========================================
# Environment Variables & Secrets
# ==========================================
# Ignorar todas las variables de entorno locales excepto los ejemplos
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local

# SI tienes un archivo de ejemplo público, puedes desmarcarlo:
# !.env.example

# ==========================================
# IDEs & System Files
# ==========================================
.DS_Store
*.pem
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ==========================================
# Vercel & Deployment
# ==========================================
.vercel

# ==========================================
# TypeScript & Cache
# ==========================================
*.tsbuildinfo
next-env.d.ts